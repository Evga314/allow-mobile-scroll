{
	"schemaVersion": 1,
	"id": "dragscroll",
	"version": "1.2.4",
	"name": "Allow mobile scroll",
	"description": "Enables scrolling menus and lists by holding left mouse button and dragging. Designed for mobile Java Minecraft launchers.",
	"authors": [
		"Evga314"
	],
	"contact": {
		"homepage": "https://t.me/Evga314mods",
		"sources": "https://github.com/Evga314/allow-mobile-scroll",
		"issues": "https://github.com/Evga314/allow-mobile-scroll/issues"
	},
	"license": "MIT",
	"icon": "assets/dragscroll/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"ru.evga314.dragscroll.DragScrollClient"
		],
		"modmenu": [
			"ru.evga314.dragscroll.modmenu.DragScrollModMenuApi"
		]
	},
	"mixins": [
		{
			"config": "dragscroll.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
